datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   // For credentials-based authentication
  role          Role      @default(USER)
  phone         String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  bookings      Booking[]
  mealOrders    MealOrder[]
  payments      Payment[]
  invoices      Invoice[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@index([email])
}

model MealCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  meals       Meal[]

  @@index([isActive])
}

model Meal {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  shortDescription String       @db.Text
  description      String       @db.Text
  image            String?
  categoryId       String
  category         MealCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  price            Float
  calories         Int
  protein          Int
  carbs            Int
  fat              Int
  ingredients      String       @db.Text
  benefits         String       @db.Text
  preparationNotes String       @db.Text
  isFeatured       Boolean      @default(false)
  isPublished      Boolean      @default(false)
  isAvailable      Boolean      @default(true)
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  orderItems       MealOrderItem[]

  @@index([categoryId])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([isAvailable])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  description     String?           @db.Text
  articles        Article[]
  ayurvedaContent AyurvedaContent[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Article {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String?       @db.Text
  content         String        @db.Text
  featuredImage   String?
  status          ArticleStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([publishedAt])
}

model AyurvedaContent {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  content       String        @db.Text
  featuredImage String?
  status        ArticleStatus @default(DRAFT)
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([categoryId])
  @@index([status])
}

model Book {
  id          String   @id @default(cuid())
  title       String   @unique
  slug        String   @unique
  description String   @db.Text
  author      String
  coverImage  String?
  pdfUrl      String?
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FAQ {
  id           String  @id @default(cuid())
  question     String
  answer       String  @db.Text
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
}

enum YogaClassStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum YogaSessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

model Instructor {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  bio             String      @db.Text
  profileImage    String?
  certifications  String?     @db.Text
  specialization  String
  experienceYears Int
  email           String
  phone           String?
  isActive        Boolean     @default(true)
  classes         YogaClass[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([isActive])
}

model YogaClass {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  description   String          @db.Text
  category      String
  difficulty    String
  duration      Int
  capacity      Int
  price         Float
  featuredImage String?
  isOnline      Boolean         @default(false)
  status        YogaClassStatus @default(DRAFT)
  instructorId  String
  instructor    Instructor      @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  sessions      YogaSession[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([instructorId])
  @@index([status])
}

model YogaSession {
  id             String            @id @default(cuid())
  classId        String
  class          YogaClass         @relation(fields: [classId], references: [id], onDelete: Cascade)
  startTime      DateTime
  endTime        DateTime
  location       String
  meetingLink    String?
  capacity       Int
  availableSeats Int
  status         YogaSessionStatus @default(SCHEDULED)
  bookings       Booking[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([classId])
  @@index([startTime])
  @@index([status])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AttendanceStatus {
  NOT_MARKED
  PRESENT
  ABSENT
}

model Booking {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  yogaSessionId    String
  yogaSession      YogaSession      @relation(fields: [yogaSessionId], references: [id], onDelete: Cascade)
  bookingStatus    BookingStatus    @default(CONFIRMED)
  attendanceStatus AttendanceStatus @default(NOT_MARKED)
  notes            String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, yogaSessionId])
  @@index([userId])
  @@index([yogaSessionId])
  @@index([bookingStatus])
}

enum MealOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model MealOrder {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAmount     Float
  status          MealOrderStatus @default(PENDING)
  deliveryDate    DateTime
  deliveryNotes   String?         @db.Text
  addressSnapshot String          @db.Text
  phoneSnapshot   String
  items           MealOrderItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model MealOrderItem {
  id         String    @id @default(cuid())
  orderId    String
  order      MealOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mealId     String
  meal       Meal      @relation(fields: [mealId], references: [id], onDelete: Restrict)
  quantity   Int
  unitPrice  Float
  totalPrice Float

  @@index([orderId])
  @@index([mealId])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  APPLE_PAY
  GOOGLE_PAY
  MANUAL
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  GOOGLE_PAY
  PAYPAL
  BANK_TRANSFER
}

enum InvoiceStatus {
  PAID
  UNPAID
  VOID
  REFUNDED
}

model Payment {
  id                 String          @id @default(cuid())
  paymentReference   String          @unique
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           PaymentProvider
  providerPaymentId  String?
  providerOrderId    String?
  amount             Float
  currency           String          @default("USD")
  status             PaymentStatus   @default(PENDING)
  paymentMethod      PaymentMethod
  relatedEntityType  String
  relatedEntityId    String
  metadata           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  
  invoices           Invoice[]
  auditLogs          PaymentAudit[]

  @@index([userId])
  @@index([paymentReference])
  @@index([status])
  @@index([provider])
  @@index([createdAt])
  @@index([relatedEntityType, relatedEntityId])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  paymentId     String
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtotal      Float
  taxAmount     Float
  totalAmount   Float
  currency      String
  status        InvoiceStatus @default(UNPAID)
  generatedAt   DateTime      @default(now())
  createdAt     DateTime      @default(now())

  @@index([userId])
  @@index([paymentId])
  @@index([invoiceNumber])
}

model PaymentAudit {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  action      String
  performedBy String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([paymentId])
  @@index([createdAt])
}


